# Telepilot v0 local configuration reference
#
# Telepilot is a GitHub Action. In workflows, pass sensitive values via GitHub
# Actions secrets instead of committing a .env file. This template exists for
# local action-contract testing and documentation only.

# Required for the v0 OpenAI-compatible adapter.
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# Optional Telegram relay. Both values are required to enable delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated allowlist. When set, TELEGRAM_CHAT_ID must be included.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional one-way completion summary for Clarion. The payload includes only
# action metadata and a response digest, never a prompt, full response, token,
# repository source, or other credentials.
CLARION_EVENT_ENDPOINT=
CLARION_EVENT_SECRET=
CLARION_ORGANIZATION_ID=
# Set true only when Clarion event delivery is a release-critical dependency.
CLARION_EVENT_REQUIRED=false
