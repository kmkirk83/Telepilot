# Telegram Bot Token - get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# GitHub Personal Access Token with Copilot access
# Requires: GitHub Copilot subscription
# Scopes needed: copilot (or use a token from an IDE that has Copilot active)
GITHUB_TOKEN=your_github_token_here

# (Optional) Restrict access to specific Telegram user IDs (comma-separated)
# Leave empty to allow all users
ALLOWED_USER_IDS=

# (Optional) GitHub Copilot API base URL
COPILOT_API_URL=https://api.githubcopilot.com

# (Optional) Model to use for Copilot chat (default: gpt-4o)
COPILOT_MODEL=gpt-4o

# (Optional) Maximum conversation history to keep per user (default: 20 messages)
MAX_HISTORY=20
