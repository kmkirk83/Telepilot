# Environment Variables for Telepilot
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.

# ─── Telegram ───────────────────────────────────────────────────────────────

# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: Public HTTPS URL for Telegram webhooks.
# If omitted, Telepilot falls back to long-polling (useful for local dev).
TELEGRAM_WEBHOOK_URL=

# Optional: Secret token to validate incoming webhook requests from Telegram.
# Generate a long random string, e.g.: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ─── GitHub / Copilot ───────────────────────────────────────────────────────

# Required: GitHub Personal Access Token (PAT) or GitHub App installation token.
# Required scopes: copilot (for Copilot API) or models:read (for GitHub Models).
GITHUB_TOKEN=

# Optional: Override the GitHub Copilot API endpoint.
# Default: https://api.githubcopilot.com
GITHUB_COPILOT_ENDPOINT=

# Optional: GitHub Models inference endpoint (alternative to Copilot API).
# Default: https://models.inference.ai.azure.com
GITHUB_MODELS_ENDPOINT=

# ─── Access Control ─────────────────────────────────────────────────────────

# Optional: Comma-separated list of Telegram user IDs allowed to use the bot.
# If empty, all users who message the bot can use it.
# Example: ALLOWED_TELEGRAM_USERS=123456789,987654321
ALLOWED_TELEGRAM_USERS=

# ─── Server ─────────────────────────────────────────────────────────────────

# Optional: HTTP port for the webhook listener.
# Default: 3000
PORT=3000

# ─── Logging ────────────────────────────────────────────────────────────────

# Optional: Log level — debug | info | warn | error
# Default: info
LOG_LEVEL=info
