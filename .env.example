# Telepilot connector platform environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Tenant API keys in tenantId:apiKey format, comma separated.
API_KEYS=tenant-default:replace-with-strong-api-key

# Tenant provider routing in tenantId:provider format.
# Supported providers: copilot, openai, mcp
TENANT_PROVIDERS=tenant-default:copilot

# Telegram ingress
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Provider credentials
COPILOT_API_KEY=
OPENAI_API_KEY=
MCP_BASE_URL=https://example-mcp-gateway.internal

# Rate limiting and async processing
QUEUE_MAX_RETRIES=3
QUEUE_BACKOFF_MS=50
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# OAuth-ready scaffolding
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
